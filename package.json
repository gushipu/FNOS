{
  "name": "fnos-client",
  "version": "3.2.3",
  "description": "飞牛 NAS 桌面客户端 · 多服务器独立分区 · 内置 MPV 播放内核",
  "author": "gushipu",
  "license": "MIT",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64 --publish never"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "afterPack": "build/after-pack.js",
    "appId": "com.gushipu.fnos",
    "productName": "FNOS",
    "copyright": "Copyright © 2026 FNOS",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.md",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "mpv",
        "to": "mpv",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "mpv-config",
        "to": "mpv-config",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "FNOS-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "飞牛 NAS",
      "artifactName": "FNOS-${version}-setup.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "连接局域网内的飞牛 NAS 设备，浏览文件与播放媒体",
        "NSBonjourServices": [
          "_http._tcp",
          "_https._tcp",
          "_fnos._tcp"
        ]
      },
      "artifactName": "FNOS-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "飞牛 NAS ${version}"
    }
  },
  "productName": "FNOS",
  "private": true
}
