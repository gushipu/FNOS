{
  "name": "fnos-client",
  "productName": "FNOS",
  "version": "2.0.0",
  "description": "飞牛 NAS 桌面客户端 · 多服务器独立分区 · 内置播放内核 · 电视直播",
  "main": "src/main/index.js",
  "author": "gushipu",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --arm64 --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.gushipu.fnos",
    "productName": "FNOS",
    "copyright": "Copyright © 2026 FNOS",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.md",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "FNOS-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "飞牛 NAS",
      "artifactName": "FNOS-${version}-setup.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "FNOS-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "飞牛 NAS ${version}"
    }
  }
}
